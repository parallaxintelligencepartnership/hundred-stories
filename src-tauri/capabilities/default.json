{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The game window: core, the save slot in the app data directory, and the export and import dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
