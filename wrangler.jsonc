{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hundred-stories",
  // The Worker answers /api/feedback only. run_worker_first stays unset, so every request that
  // matches a file in dist/ is served as a static asset without invoking the Worker.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Player feedback, held until the mailer on the tailnet reads it.
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "242d9b50825d4d16988a03b052fedb3a" }
  ],
  // 5 feedback posts per 60 seconds per client IP, then 2 per 60 seconds for everyone together
  // (key "global"), which holds KV writes to 2,880 a day at most.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FEEDBACK_GLOBAL", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  "routes": [
    { "pattern": "hundredstories.xyz", "custom_domain": true },
    { "pattern": "www.hundredstories.xyz", "custom_domain": true }
  ]
}
