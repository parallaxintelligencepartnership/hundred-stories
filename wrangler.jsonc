{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hundred-stories",
  // The Worker answers /api/feedback and the videos under /trailers/ (run_worker_first below).
  // Every other request is served by the assets layer without invoking the Worker.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The assets binding ignores Range and always answers 200 with the whole file; Safari and iOS
    // need 206 to play mp4, so the Worker answers /trailers/* first (src/worker/range.ts).
    // /api/* must be listed too: with the list form and not_found_handling "404-page", every path
    // not listed goes to the assets layer (404 page on GET, empty 405 on POST) and never reaches
    // the Worker, which is how feedback went dead live from 0.6.8 to 0.6.11.
    "run_worker_first": ["/trailers/*", "/api/*"]
  },
  // Player feedback, held until the mailer on the tailnet reads it.
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "242d9b50825d4d16988a03b052fedb3a" }
  ],
  // Only a valid message is counted (junk is refused first). 2 feedback posts per 60 seconds per
  // client IP, then 3 per 60 seconds for everyone together (key "global"): one address alone
  // always leaves room for another sender; two addresses can fill the shared bucket.
  //
  // The daily budget is NOT enforced here. The site is on the Cloudflare free plan, whose KV
  // write cap is about 1,000 a day (unconfirmed: the figure was not checked against Cloudflare's
  // docs). A limiter's period is 10 or 60 seconds, so it cannot hold a daily budget: the shared
  // bucket still allows 3 x 1,440 = 4,320 writes a day, over the cap. When the cap is spent,
  // every KV put fails; the Worker answers 507 "full for today" and the feedback card says
  // "Feedback is full for today. Try again tomorrow." until the daily count resets.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
    { "name": "FEEDBACK_GLOBAL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "routes": [
    { "pattern": "hundredstories.xyz", "custom_domain": true },
    { "pattern": "www.hundredstories.xyz", "custom_domain": true }
  ]
}
