{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hundred-stories",
  // The Worker answers /api/feedback and the videos under /trailers/. Every other request that
  // matches a file in dist/ is served as a static asset without invoking the Worker.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The assets binding ignores Range and always answers 200 with the whole file; Safari and iOS
    // need 206 to play mp4, so the Worker answers /trailers/* first (src/worker/range.ts).
    "run_worker_first": ["/trailers/*"]
  },
  // Player feedback, held until the mailer on the tailnet reads it.
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "242d9b50825d4d16988a03b052fedb3a" }
  ],
  // Only a valid message is counted (junk is refused first). 2 feedback posts per 60 seconds per
  // client IP, then 6 per 60 seconds for everyone together (key "global"): the per-IP limit sits
  // well below the shared one, so it takes at least three addresses to fill the shared bucket.
  // The shared bucket holds KV writes to 8,640 a day at most (6 x 1,440).
  // Unverified: the KV free tier's daily write cap was not checked against this figure.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
    { "name": "FEEDBACK_GLOBAL", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ],
  "routes": [
    { "pattern": "hundredstories.xyz", "custom_domain": true },
    { "pattern": "www.hundredstories.xyz", "custom_domain": true }
  ]
}
