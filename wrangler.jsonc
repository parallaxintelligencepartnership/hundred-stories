{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hundred-stories",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "hundredstories.xyz", "custom_domain": true },
    { "pattern": "www.hundredstories.xyz", "custom_domain": true }
  ]
}
