{
  "name": "Hundred Stories feedback mailer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.cloudflare.com/client/v4/accounts/c50b1304a5eb5e5a006ba60483d58aeb/storage/kv/namespaces/242d9b50825d4d16988a03b052fedb3a/keys",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        },
        "options": {}
      },
      "name": "List feedback keys",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Cloudflare n8n-feedback-kv"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "result",
        "options": {}
      },
      "name": "One item per key",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.cloudflare.com/client/v4/accounts/c50b1304a5eb5e5a006ba60483d58aeb/storage/kv/namespaces/242d9b50825d4d16988a03b052fedb3a/values/{{ encodeURIComponent($json.name) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Read the message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Cloudflare n8n-feedback-kv"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "Hundred Stories feedback <matthew@parallaxintelligence.ai>",
        "toEmail": "requests@hundredstories.xyz",
        "subject": "=[Hundred Stories] feedback from a player ({{ $json.platform || 'unknown' }}, {{ $json.version || '?' }})",
        "emailFormat": "text",
        "text": "={{ $json.text }}\n\n---\nReply to: {{ $json.replyTo || 'not given' }}\nVersion: {{ $json.version || '?' }}\nPlatform: {{ $json.platform || '?' }}\nScreen: {{ $json.screen || '?' }}\nSent: {{ $json.at || '?' }}\nKey: {{ $('One item per key').item.json.name }}",
        "options": {
          "replyTo": "={{ $json.replyTo || '' }}"
        }
      },
      "name": "Email Matt",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "name": "MATTHEW @ AI"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "email-sent-no-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notExists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "name": "Email sent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://api.cloudflare.com/client/v4/accounts/c50b1304a5eb5e5a006ba60483d58aeb/storage/kv/namespaces/242d9b50825d4d16988a03b052fedb3a/values/{{ encodeURIComponent($('One item per key').item.json.name) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Delete the key",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Cloudflare n8n-feedback-kv"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "Hundred Stories feedback mail could not be sent. The messages are still stored and will be tried again next hour."
      },
      "id": "mail-failed-stop",
      "name": "Mail failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1320,
        180
      ]
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "List feedback keys",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List feedback keys": {
      "main": [
        [
          {
            "node": "One item per key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per key": {
      "main": [
        [
          {
            "node": "Read the message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the message": {
      "main": [
        [
          {
            "node": "Email Matt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Matt": {
      "main": [
        [
          {
            "node": "Email sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email sent": {
      "main": [
        [
          {
            "node": "Delete the key",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mail failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "GAqcaSygWIaIZg9u"
  },
  "meta": {
    "note": "Imported into n8n on 2026-09-27 as workflow Hundred Stories feedback mailer. Header credential: Cloudflare n8n-feedback-kv (token in the Mac keychain as cloudflare-n8n-feedback-kv, Workers KV Storage:Edit). Mail: the MATTHEW @ AI SMTP credential (Spacemail), from matthew@parallaxintelligence.ai to requests@hundredstories.xyz, Reply-To the player when given. Matt wants the sender to be a hundredstories.xyz address: that needs an n8n SMTP credential for the Microsoft 365 mailbox (smtp.office365.com, port 587, STARTTLS, user requests@hundredstories.xyz, its password or an app password, with authenticated SMTP enabled for that mailbox in Exchange admin); until then the sender is named Hundred Stories feedback on the .ai address."
  }
}
