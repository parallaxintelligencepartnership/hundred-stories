{
  "name": "hundred-stories",
  "version": "0.4.8",
  "description": "A downtown skyscraper simulation: run and operate a tower, one hundred stories tall.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_EDITION=demo vite build",
    "build:full": "tsc --noEmit && VITE_EDITION=full vite build",
    "build:app": "tsc --noEmit && VITE_EDITION=full vite build --mode app",
    "cap:sync": "npm run build:app && cap sync",
    "preview": "vite preview",
    "preview:worker": "npm run build && npx wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/make-og.mjs",
    "icons": "node scripts/make-icons.mjs",
    "store:shots": "node scripts/make-store-shots.mjs",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tauri-apps/cli": "2.11.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
