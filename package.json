{
  "name": "hundred-stories",
  "version": "0.4.1",
  "description": "A downtown skyscraper simulation: run and operate a tower, one hundred stories tall.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && npx wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/make-og.mjs",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
